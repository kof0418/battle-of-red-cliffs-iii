{
  "name": "three-kingdoms-battle",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "release": "npm test && npm run build && python3 scripts/package_release.py",
    "desktop:build:mac": "tauri build --bundles app --target aarch64-apple-darwin"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "@tauri-apps/cli": "^2.0.0"
  }
}
